# ============================================================
# ECG Admin Backend — environment variables
# Copy this file to `.env` and fill in real values before running.
# ============================================================

# --- MongoDB ---
# Local: mongodb://localhost:27017/ecg_admin
# Docker compose: mongodb://mongo:27017/ecg_admin
MONGO_URI=mongodb://localhost:27017/ecg_admin

# --- JWT ---
# MUST be random 64+ char strings in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-min-64-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-64-chars
JWT_ACCESS_EXPIRY=30m
JWT_REFRESH_EXPIRY=7d

# --- Server ---
PORT=3001
NODE_ENV=development

# --- CORS / Frontend ---
# Canonical: the origin of the frontend that is allowed to call this API.
# Multiple origins may be comma-separated (e.g. admin + staging).
FRONTEND_URL=http://localhost:3000
# Legacy alias, merged with FRONTEND_URL if set:
# CORS_ORIGIN=https://staging.example.com

# --- Rate Limiting ---
# General API: 100 requests / 15 minutes
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Login: 5 requests / 15 minutes (brute force protection)
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5

# --- Email (Brevo / transactional) ---
BREVO_API_KEY=
BREVO_SENDER_NAME=ECG Admin Panel
BREVO_SENDER_EMAIL=no-reply@example.com
